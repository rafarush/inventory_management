# Django secret key (replace with a secure key in production)
SECRET_KEY=your-secret-key-here

# Debug mode (True or False)
DEBUG=True

# Allowed hosts (comma separated if multiple)
ALLOWED_HOSTS=your-domain.com,localhost

# CSRF trusted origins (comma separated if multiple)
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database settings (PostgreSQL example)
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=5432

# Local Database settings (for local development)
LOCAL_DB_NAME=your-local-db-name
LOCAL_DB_USER=your-local-db-user
LOCAL_DB_PASSWORD=your-local-db-password
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
